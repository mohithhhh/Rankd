ENV=development

# Supabase Session Pooler connection string (IPv4-compatible, safe for Alembic).
# Find via the "Connect" button at the top of the Supabase project dashboard.
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase project URL (Project Settings -> API). The backend fetches the
# public JWKS from <this>/auth/v1/.well-known/jwks.json to verify ES256 tokens.
SUPABASE_URL=https://<project-ref>.supabase.co

# OPTIONAL legacy HS256 secret (Project Settings -> JWT Keys -> Legacy JWT Secret).
# Leave blank/unset once the legacy key is revoked - blank means HS256 tokens are rejected.
SUPABASE_JWT_SECRET=

# Comma-separated Supabase user ids (Authentication -> Users -> UID) allowed to
# create gyms via POST /gyms. Empty = nobody can. Ids are not secret.
PLATFORM_ADMIN_USER_IDS=

# Dev-only bypass for auth; must be false/unset in production (hard-fail if ENV=production)
AUTH_DISABLED=false
